+// The stage HUD spells TIME using four consecutive character tiles. Its
+// fixed atlas coordinates distinguish gameplay from the title and story art.
+static bool street_stage_hud()
+{
+	if (!(scroll_flag[2] & 0x10) || scrollx[2] || scrolly[2]) return false;
+	const UINT16 *text = (const UINT16 *)DrvScrRAM[2];
+	for (int i = 0; i < 4; ++i) {
+		const int tile = BURN_ENDIAN_SWAP_INT16(text[(14 + i) * 32 + 3]) & 0xfff;
+		if (tile != 0x154 + i) return false;
+	}
+	return true;
+}
+
+// Both scenery planes and the characters use the same screen origin. At
+// the start of a street, show the extra space ahead until there is scenery
+// behind the original camera. Never wrap to the far end of the map there.
+static int street_camera_margin(bool stage)
+{
+	if (!stage) return STREET64_MARGIN;
+	return (scrollx[0] < STREET64_MARGIN) ? scrollx[0] : STREET64_MARGIN;
+}
